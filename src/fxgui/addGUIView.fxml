<?xml version="1.0" encoding="UTF-8"?>

<?import fi.jyu.mit.fxgui.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fxgui.addGUIController">
    <top>
        <Label text="Add" BorderPane.alignment="CENTER">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
         <BorderPane.margin>
            <Insets bottom="10.0" />
         </BorderPane.margin>
        </Label>
    </top>
    <center>
        <GridPane hgap="10.0" vgap="10.0" BorderPane.alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints />
            </rowConstraints>
            <children>
                <Label text="Date" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <ScrollPane fitToWidth="true" prefHeight="300.0" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <content>
                        <ListChooser fx:id="chooserDatesTodo" prefWidth="130.0" />
                    </content>
                </ScrollPane>
                <Label text="Todo" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextArea fx:id="newTodo" prefHeight="200.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label prefHeight="66.0" prefWidth="200.0" text="Done" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <CheckBox fx:id="isDone" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
        </GridPane>
    </center>
    <bottom>
        <HBox prefHeight="50.0" prefWidth="200.0" spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="goListButton" mnemonicParsing="false" onAction="#handleBackGUI" text="Go to main" />
                <Button fx:id="submitNewButton" mnemonicParsing="false" text="Submit" />
            </children>
        </HBox>
    </bottom>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</BorderPane>
