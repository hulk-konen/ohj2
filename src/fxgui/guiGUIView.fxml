<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import fi.jyu.mit.fxgui.ListChooser?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/11.0.14-internal"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fxgui.guiGUIController">
   <left>
      <VBox spacing="10.0" BorderPane.alignment="TOP_LEFT">
         <children>
            <Label text="Saved Dates">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <ScrollPane fitToWidth="true" prefHeight="300.0" prefWidth="150.0">
               <content>
                  <ListChooser fx:id="chooserDates" prefWidth="130.0" />
               </content>
            </ScrollPane>
            <Button mnemonicParsing="false" text="Add New Date" onAction="#handleAddNewPvm" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </left>
   <top>
      <Label text="Daily Print" BorderPane.alignment="CENTER">
         <font>
            <Font name="System Bold" size="16.0" />
         </font></Label>
   </top>
   <center>
      <TextArea fx:id="textAreaPrintti" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER"
                editable="false" wrapText="true">
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </TextArea>
   </center>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <bottom>
      <HBox prefHeight="50.0" prefWidth="200.0" spacing="10.0" BorderPane.alignment="TOP_LEFT">
         <children>
            <Label text="Create / Edit todos" />
            <Button fx:id="todoGUIButton" mnemonicParsing="false" text="Add todo" onAction="#handleAddNewTodo" />
         </children>
      </HBox>
   </bottom>
</BorderPane>